{
  "name": "meadowvale",
  "version": "1.0.0",
  "private": true,
  "description": "Meadowvale - an endless, seeded city-building sandbox in the browser: farms, towns, cities, economies and living residents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bash tests/run.sh",
    "balance": "bash tests/run.sh balance",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "start": "vite build && node server/index.js",
    "test:server": "node --test tests/server.test.js",
    "test:multiplayer": "node tests/multiplayer.e2e.js"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "keywords": [
    "city-builder",
    "game",
    "isometric",
    "canvas",
    "procedural-generation"
  ],
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "mongodb": "^6.21.0",
    "ws": "^8.22.0"
  }
}
